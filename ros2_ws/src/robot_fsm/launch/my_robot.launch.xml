<launch>
  <node pkg="robot_fsm" exec="robot_fsm" output="screen"/>
  <node pkg="steering_input" exec="steering_input_node" output="screen"/>
  <node pkg="leg_controller" exec="leg_controller" output="screen">
    <param name="wide_steering_angle" value="0.5"/>
  </node>
  <node pkg="mobility_bringup" exec="mobility_node" output="screen">
    <param name="wheel_speed" value="0.2"/>
  </node>
</launch>
