<launch>
  <let name="config" value="$(find-pkg-share robot_fsm)/config/my_robot.yaml"/>

  <node pkg="steering_controller" exec="steering_controller_node" output="screen">
    <param from="$(var config)" path="steering_controller"/>
  </node>
  <node pkg="actuator_executor" exec="actuator_executor_node" output="screen">
    <param from="$(var config)" path="actuator_executor"/>
  </node>
  <node pkg="mobility_controller" exec="mobility_controller_node" output="screen">
    <param from="$(var config)" path="mobility_controller"/>
  </node>
</launch>
