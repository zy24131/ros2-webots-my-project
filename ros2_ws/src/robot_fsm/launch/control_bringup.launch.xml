<launch>
  <!-- Humble 兼容：参数 inline（my_robot.yaml 仍作配置参考） -->
  <node pkg="robot_fsm" exec="robot_fsm" output="screen"/>
  <node pkg="steering_controller" exec="steering_controller_node" output="screen">
    <param name="wide_neutral_angle_deg" value="45.0"/>
    <param name="steering_deadband_deg" value="3.0"/>
  </node>
  <node pkg="actuator_executor" exec="actuator_executor_node" output="screen">
    <param name="position_tolerance" value="0.05"/>
    <param name="wide_neutral_angle_deg" value="45.0"/>
    <param name="command_timeout_ms" value="450"/>
  </node>
  <node pkg="mobility_controller" exec="mobility_controller_node" output="screen">
    <param name="wheel_speed" value="0.0"/>
    <param name="track_half_width_narrow" value="1.07"/>
    <param name="track_half_width_wide" value="1.25"/>
  </node>
</launch>
