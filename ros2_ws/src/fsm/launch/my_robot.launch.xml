<!-- Default entry: run_webots.sh (hardware_bridge) + this launch (control stack) -->
<launch>
  <arg name="params_file"
       default="$(find-pkg-share fsm)/config/my_robot.yaml"
       description="Override stack parameters"/>

  <include file="$(find-pkg-share fsm)/launch/control_bringup.launch.xml">
    <arg name="params_file" value="$(var params_file)"/>
  </include>
</launch>
